# Copy to .env.local
EXECUTION_ENABLED=false
DESIGNATED_AMOUNT_USD=100
MAX_SLIPPAGE_BPS=30
VENUE_PRIORITY=kalshi

# MOCK_MODE covers Phase 1 (/api/markets) and Phase 2 (/api/match,
# /api/opportunities/stream, workers/feed.py) — set to false only once
# everything below is filled in with real credentials.
MOCK_MODE=true

OPENAI_API_KEY=

# Render injects these two automatically for services wired via
# render.yaml's fromDatabase / fromService — only needed here for local dev
# against a real Render Postgres/Key Value instance.
DATABASE_URL=
REDIS_URL=

# Shared secret the discovery cron job sends as a Bearer token to /api/match
# so it can't be triggered by an arbitrary public POST. Set the same value
# here and in the albatross-discovery cron service on Render.
CRON_SHARED_SECRET=

KALSHI_API_KEY=
KALSHI_SECRET=
POLY_PRIVATE_KEY=
